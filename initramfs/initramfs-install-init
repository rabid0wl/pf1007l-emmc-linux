#!/bin/sh
# AEEZO frame bring-up init: RAM-only Alpine, shell on the USB gadget serial port.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
hostname aeezo
echo "aeezo: mainline $(uname -r) is up" > /dev/kmsg
echo "aeezo: mainline $(uname -r) is up" > /dev/tty0 2>/dev/null
# aeezo.install on the cmdline (installer initramfs only): write /payload to the eMMC.
# Everything rides in RAM via FEL; no USB gadget traffic. Gates, in order: U-Boot read the eMMC
# correctly (CRC from the FEL boot script), the eMMC is the MAG2GC part at its exact size, the
# payload checksums verify. Any failure stops before the next write.
if grep -qw aeezo.install /proc/cmdline; then
	say() { echo "aeezo: $*" > /dev/kmsg; printf '\033[1;33m   %s\033[0m\n' "$*" > /dev/tty0; }
	# the installer body runs in a subshell: die() exits it (nothing after a failed gate runs),
	# and /init carries on to the serial shell so the frame stays inspectable and rebootable
	die() { echo "aeezo: FAILED: $*" > /dev/kmsg; printf '\033[1;31m   FAILED: %s\n   (nothing further written)\033[0m\n' "$*" > /dev/tty0; exit 1; }
	(
	printf '\033[2J\033[H\n\n' > /dev/tty0
	say "AEEZO eMMC INSTALLER"

	emmc=
	for _ in $(seq 40); do
		for b in /sys/block/mmcblk?; do
			[ "$(cat $b/device/name 2>/dev/null)" = MAG2GC ] && emmc=/dev/${b##*/}
		done
		[ -n "$emmc" ] && break
		sleep 0.5
	done
	[ -n "$emmc" ] || die "eMMC (MAG2GC) not found"
	bytes=$(( $(cat /sys/block/${emmc#/dev/}/size) * 512 ))
	[ "$bytes" = 15634268160 ] || die "$emmc is $bytes bytes, expected 15634268160"
	say "1/8 eMMC $emmc, $bytes bytes"

	# U-Boot read gate: U-Boot's CRC32 of the first 16MiB (from the FEL boot script) must equal
	# Linux's CRC32 of the same bytes. gzip's trailer is the CRC32 of its input; U-Boot may hand
	# it over byte-swapped, so accept either order.
	ucrc=$(sed -n 's/.*aeezo.ubootcrc=\([^ ]*\).*/\1/p' /proc/cmdline | tr 'A-F' 'a-f' | sed 's/^0x//')
	ucrc=$(echo "00000000$ucrc" | sed 's/.*\(........\)$/\1/')
	lcrc=$(head -c 16777216 "$emmc" | gzip -1 | tail -c 8 | head -c 4 | od -An -tx4 | tr -d ' \n')
	lswap=$(echo "$lcrc" | sed 's/\(..\)\(..\)\(..\)\(..\)/\4\3\2\1/')
	# optional: CRC32 of your stock backup's first 16MiB (cosmetic label only, not a gate)
	[ "$lcrc" = "$(cat /etc/aeezo/stock-16m.crc32 2>/dev/null)" ] && stock="stock Android" || stock="not stock"
	case "$ucrc" in
		"$lcrc"|"$lswap") say "2/8 U-Boot reads the eMMC correctly (crc $lcrc, $stock)" ;;
		*) die "U-Boot eMMC read check: U-Boot crc '$ucrc', Linux crc $lcrc; U-Boot can't boot from this eMMC" ;;
	esac

	(cd /payload && sha256sum -c SHA256SUMS >/dev/null 2>&1) || die "payload checksum mismatch"
	say "3/8 payload checksums OK"

	mount -t debugfs none /sys/kernel/debug 2>/dev/null
	# write gate: the eMMC only writes reliably at <=12.5MHz (DT max-frequency); prove it here,
	# at the 4GiB mark, before the partition table is touched
	dd if=/dev/urandom of=/tmp/wpat bs=1048576 count=1 2>/dev/null
	dd if=/tmp/wpat of="$emmc" bs=1048576 seek=4096 count=1 conv=fsync 2>/dev/null || die "eMMC write test: write failed"
	sync; echo 3 > /proc/sys/vm/drop_caches; blockdev --flushbufs "$emmc"
	dd if="$emmc" bs=1048576 skip=4096 count=1 2>/dev/null | cmp -s - /tmp/wpat || die "eMMC write test: read-back mismatch"
	say "4/8 eMMC write test OK (1MiB at 4GiB, $(sed -n 's/^clock:[^0-9]*//p' /sys/kernel/debug/mmc*/ios 2>/dev/null | head -1))"

	printf 'label: dos\nlabel-id: 0xaee20000\n\nstart=8192, type=83, bootable\n' |
		sfdisk -q --wipe always --wipe-partitions always "$emmc" || die "sfdisk"
	blockdev --rereadpt "$emmc" 2>/dev/null
	part=${emmc}p1
	for _ in $(seq 20); do [ -b "$part" ] && break; sleep 0.5; done
	[ -b "$part" ] || die "$part did not appear"
	say "5/8 partitioned: $part from 4MiB, PARTUUID aee20000-01"

	mkfs.ext4 -q -F -E nodiscard -L aeezo-root "$part" >/dev/null 2>&1 || die "mkfs.ext4"
	mkdir -p /mnt/root && mount -t ext4 "$part" /mnt/root || die "mount $part"
	tar -C /mnt/root -xzpf /payload/rootfs.tar.gz || die "tar extract"
	sync
	used=$(du -sm /mnt/root | cut -f1)
	[ -f /mnt/root/boot/extlinux/extlinux.conf ] && [ -f /mnt/root/boot/zImage ] || die "rootfs incomplete after extract"
	umount /mnt/root || die "umount"
	say "6/8 rootfs written (${used}MB)"

	# read the kernel back off the eMMC (caches dropped) and check it against the build
	sync; echo 3 > /proc/sys/vm/drop_caches
	mount -t ext4 -o ro "$part" /mnt/root || die "re-mount $part"
	ksum=$(sha256sum /mnt/root/boot/zImage | cut -c1-64)
	umount /mnt/root
	# payload/zImage.sha256 = sha256 of the zImage inside rootfs.tar.gz, written at build time
	want=$(cut -c1-64 /payload/zImage.sha256 2>/dev/null)
	[ -n "$want" ] || die "payload/zImage.sha256 missing"
	[ "$ksum" = "$want" ] || die "kernel on eMMC has wrong sha256 ($ksum)"
	say "7/8 kernel read back from eMMC, sha256 matches"

	ub=/payload/u-boot-sunxi-with-spl.bin
	dd if=$ub of="$emmc" bs=1024 seek=8 conv=fsync 2>/dev/null || die "dd u-boot"
	sync; echo 3 > /proc/sys/vm/drop_caches; blockdev --flushbufs "$emmc"
	sz=$(wc -c < $ub)
	dd if="$emmc" bs=1024 skip=8 count=$(( (sz + 1023) / 1024 )) 2>/dev/null | head -c "$sz" | cmp -s - $ub ||
		die "u-boot read-back mismatch"
	say "8/8 U-Boot written at 8KiB and read back OK"

	printf '\n\033[1;32m   INSTALL OK. Rebooting from eMMC in 10s...\033[0m\n' > /dev/tty0
	echo "aeezo: INSTALL OK" > /dev/kmsg
	sync
	sleep 10
	reboot -f
	)
fi

# aeezo.ums on the cmdline (flasher kernel, mass storage only): self-test the eMMC with no USB
# involved, show the verdict on the panel, then export the eMMC (found by chip name; mmcblk0/1
# swaps between boots) through the gadget's LUN.
if grep -qw aeezo.ums /proc/cmdline; then
	say() { echo "aeezo: $*" > /dev/kmsg; printf '\033[1;33m   %s\033[0m\n' "$*" > /dev/tty0; }
	printf '\033[2J\033[H\n\n' > /dev/tty0
	emmc=; lun=
	for _ in $(seq 40); do
		for b in /sys/block/mmcblk?; do
			[ "$(cat $b/device/name 2>/dev/null)" = MAG2GC ] && emmc=/dev/${b##*/}
		done
		lun=$(ls /sys/devices/platform/soc/*.usb/musb-hdrc.*/gadget*/lun0/file 2>/dev/null | head -1)
		[ -n "$emmc" ] && [ -n "$lun" ] && break
		sleep 0.5
	done
	say "eMMC: ${emmc:-NOT FOUND}   LUN: ${lun:-NOT FOUND}"
	if [ -n "$emmc" ]; then
		say "self-test: reading first 64MB (stuck here = eMMC read hang)..."
		t0=$(cut -d. -f1 /proc/uptime)
		got=$(dd if="$emmc" bs=1048576 count=64 2>/dev/null | sha256sum | cut -c1-64)
		secs=$(( $(cut -d. -f1 /proc/uptime) - t0 ))
		# sha256 of the first 64MiB of YOUR stock backup, baked into the initramfs (see README)
		want=$(cat /etc/aeezo/stock-64m.sha256 2>/dev/null | cut -c1-64)
		if [ -n "$want" ] && [ "$got" = "$want" ]; then
			say "self-test PASS: 64MB in ${secs}s, hash matches stock backup"
		else
			say "self-test MISMATCH: $(echo $got | cut -c1-16)... in ${secs}s (ok only if already flashed)"
		fi
	fi
	if [ -n "$emmc" ] && [ -n "$lun" ] && echo "$emmc" > "$lun"; then
		say "exported $emmc over USB mass storage"
	else
		say "eMMC export FAILED"
	fi
	while true; do sleep 3600; done
fi

# wait for the gadget tty, then keep a root shell on it forever
while [ ! -e /dev/ttyGS0 ]; do sleep 0.5; done
while true; do
	/sbin/getty -n -l /bin/sh 115200 ttyGS0 vt100
	sleep 1
done
