+/*
+ * AEEZO U708HC photo frame: vendor timings from sys_config lcd0_para (Allwinner's
+ * lcd_hbp/lcd_vbp include the sync width) and lcd_dsi_if = 0, i.e. non-burst video.
+ */
+static const struct jadard_panel_desc aeezo_u708hc_desc = {
+	.mode_4ln = &(const struct drm_display_mode) {
+		.clock		= 67000,
+
+		.hdisplay	= 800,
+		.hsync_start	= 800 + 18,
+		.hsync_end	= 800 + 18 + 18,
+		.htotal		= 800 + 18 + 18 + 18,
+
+		.vdisplay	= 1280,
+		.vsync_start	= 1280 + 20,
+		.vsync_end	= 1280 + 20 + 4,
+		.vtotal		= 1280 + 20 + 4 + 10,
+
+		.width_mm	= 135,
+		.height_mm	= 216,
+		.type		= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+	},
+	.lanes = 4,
+	.format = MIPI_DSI_FMT_RGB888,
+	.init = aeezo_u708hc_init_cmds,
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+		      MIPI_DSI_MODE_LPM,
+};
+
+/*
+ * Bring-up knob: toggle DSI burst mode on the live device, picked up on the next
+ * encoder enable (e.g. a console blank/unblank cycle).
+ */
+static struct mipi_dsi_device *aeezo_dsi;
+
+static int aeezo_burst_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_bool(val, kp);
+
+	if (ret || !aeezo_dsi)
+		return ret;
+	if (*(bool *)kp->arg)
+		aeezo_dsi->mode_flags |= MIPI_DSI_MODE_VIDEO_BURST;
+	else
+		aeezo_dsi->mode_flags &= ~MIPI_DSI_MODE_VIDEO_BURST;
+	dev_info(&aeezo_dsi->dev, "mode_flags now 0x%lx\n", aeezo_dsi->mode_flags);
+	return 0;
+}
+
+static const struct kernel_param_ops aeezo_burst_ops = {
+	.set = aeezo_burst_set,
+	.get = param_get_bool,
+};
+
+static bool aeezo_burst;
+module_param_cb(aeezo_burst, &aeezo_burst_ops, &aeezo_burst, 0644);
+MODULE_PARM_DESC(aeezo_burst, "AEEZO U708HC bring-up: use DSI burst mode");
+
