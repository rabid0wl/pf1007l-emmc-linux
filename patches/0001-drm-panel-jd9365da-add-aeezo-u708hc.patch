+		aeezo_dsi = dsi;
+		if (aeezo_burst)
+			dsi->mode_flags |= MIPI_DSI_MODE_VIDEO_BURST;
+	}
+
 	dsi->format = desc->format;
 	dsi->lanes = desc->lanes;
 	if (!dsi->lanes) {
@@ -3276,6 +3552,10 @@
